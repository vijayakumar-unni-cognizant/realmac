<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/realmac/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="realmac/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="realmac/components/container"
            layout="simple">
            <site-header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="realmac/components/site-header"
                logoFileReference="/content/dam/realmac/tata-innovation/tata-logo.svg"
                logoAlt="Realmac"
                navigationRoot="/content/realmac/us/en"
                navigationStructureDepth="{Long}1">
                <utilityLinks jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        label="Search"
                        iconFileReference="/content/dam/realmac/tata-innovation/search.svg"
                        linkURL="/content/realmac/us/en/search.html"
                        ariaLabel="Search"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        label="Contact"
                        iconFileReference="/content/dam/realmac/tata-innovation/ContactUs.svg"
                        linkURL="/content/realmac/us/en/contact.html"
                        ariaLabel="Contact us"/>
                </utilityLinks>
            </site-header>
        </root>
    </jcr:content>
</jcr:root>
