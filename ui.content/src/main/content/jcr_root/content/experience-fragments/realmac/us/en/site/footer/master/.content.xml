<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/realmac/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="realmac/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="realmac/components/container"
            layout="responsiveGrid">
            <site-footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="realmac/components/site-footer"
                legalText="&#169; 2026 Realmac. All rights reserved.">
                <columns jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" heading="Company">
                        <links jcr:primaryType="nt:unstructured">
                            <item0 jcr:primaryType="nt:unstructured" label="About Us" url="/content/realmac/us/en/about.html"/>
                            <item1 jcr:primaryType="nt:unstructured" label="Careers" url="/content/realmac/us/en/careers.html"/>
                            <item2 jcr:primaryType="nt:unstructured" label="Newsroom" url="/content/realmac/us/en/newsroom.html"/>
                        </links>
                    </item0>
                    <item1 jcr:primaryType="nt:unstructured" heading="Innovation">
                        <links jcr:primaryType="nt:unstructured">
                            <item0 jcr:primaryType="nt:unstructured" label="Innovation Overview" url="/content/realmac/us/en/innovation.html"/>
                            <item1 jcr:primaryType="nt:unstructured" label="Research Centres" url="/content/realmac/us/en/innovation.html"/>
                        </links>
                    </item1>
                    <item2 jcr:primaryType="nt:unstructured" heading="Resources">
                        <links jcr:primaryType="nt:unstructured">
                            <item0 jcr:primaryType="nt:unstructured" label="Media Library" url="/content/realmac/us/en/media.html"/>
                            <item1 jcr:primaryType="nt:unstructured" label="Publications" url="/content/realmac/us/en/publications.html"/>
                        </links>
                    </item2>
                    <item3 jcr:primaryType="nt:unstructured" heading="Legal">
                        <links jcr:primaryType="nt:unstructured">
                            <item0 jcr:primaryType="nt:unstructured" label="Privacy Policy" url="/content/realmac/us/en/privacy.html"/>
                            <item1 jcr:primaryType="nt:unstructured" label="Terms of Use" url="/content/realmac/us/en/terms.html"/>
                        </links>
                    </item3>
                </columns>
                <socialLinks jcr:primaryType="nt:unstructured">
                    <item0 jcr:primaryType="nt:unstructured" iconFileReference="/content/dam/realmac/tata-innovation/FB.svg" url="https://www.facebook.com/realmac" label="Facebook"/>
                    <item1 jcr:primaryType="nt:unstructured" iconFileReference="/content/dam/realmac/tata-innovation/Linkedin.svg" url="https://www.linkedin.com/company/realmac" label="LinkedIn"/>
                    <item2 jcr:primaryType="nt:unstructured" iconFileReference="/content/dam/realmac/tata-innovation/Instagram.svg" url="https://www.instagram.com/realmac" label="Instagram"/>
                    <item3 jcr:primaryType="nt:unstructured" iconFileReference="/content/dam/realmac/tata-innovation/ContactUs.svg" url="/content/realmac/us/en/contact.html" label="Contact"/>
                </socialLinks>
            </site-footer>
        </root>
    </jcr:content>
</jcr:root>
